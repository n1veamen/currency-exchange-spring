{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Currency Exchange Spring API (Render)",
    "description": "Коллекция для тестирования REST API проекта **currency-exchange-spring** в облаке Render.\n\n## Запуск\n1. Базовый URL: `https://currency-exchange-spring.onrender.com`\n2. БД: PostgreSQL (Neon)\n\n## Порядок тестов\nПапка **00 — Setup (run in order)** → затем остальные сценарии.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://currency-exchange-spring.onrender.com"
    }
  ],
  "item": [
    {
      "name": "00 — Setup (run in order)",
      "description": "Запускайте запросы сверху вниз на чистой БД. После этого можно тестировать Exchange и негативные сценарии.",
      "item": [
        {
          "name": "1. Create USD",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"USD\",\n  \"fullName\": \"United States Dollar\",\n  \"sign\": \"$\"\n}"
            },
            "url": "{{baseUrl}}/currencies",
            "description": "Ожидается **201 Created** (без тела)."
          },
          "response": []
        },
        {
          "name": "2. Create RUB",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"RUB\",\n  \"fullName\": \"Russian Ruble\",\n  \"sign\": \"₽\"\n}"
            },
            "url": "{{baseUrl}}/currencies",
            "description": "Ожидается **201 Created**."
          },
          "response": []
        },
        {
          "name": "3. Create EUR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"EUR\",\n  \"fullName\": \"Euro\",\n  \"sign\": \"€\"\n}"
            },
            "url": "{{baseUrl}}/currencies",
            "description": "Ожидается **201 Created**."
          },
          "response": []
        },
        {
          "name": "4. Create rate USD → RUB",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"baseCurrencyCode\": \"USD\",\n  \"targetCurrencyCode\": \"RUB\",\n  \"rate\": 90.50\n}"
            },
            "url": "{{baseUrl}}/exchange-rates",
            "description": "Хаб-курс через USD. Ожидается **201 Created**."
          },
          "response": []
        },
        {
          "name": "5. Create rate USD → EUR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"baseCurrencyCode\": \"USD\",\n  \"targetCurrencyCode\": \"EUR\",\n  \"rate\": 0.92\n}"
            },
            "url": "{{baseUrl}}/exchange-rates",
            "description": "Ожидается **201 Created**."
          },
          "response": []
        },
        {
          "name": "6. Verify — Get all currencies",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/currencies",
            "description": "Проверка: 3 валюты (USD, RUB, EUR)."
          },
          "response": []
        },
        {
          "name": "7. Verify — Get all exchange rates",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/exchange-rates",
            "description": "Проверка: 2 курса (USD/RUB, USD/EUR)."
          },
          "response": []
        }
      ]
    },
    {
